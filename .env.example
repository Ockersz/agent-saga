# ==============================================================================
# AgentSaga-Gateway Environment Configuration Example
# ==============================================================================

# Gateway HTTP Server
PORT=8080
UPSTREAM_SERVICES_URL=http://127.0.0.1:3000
CONTRACTS_DIR=../contracts

# Dynamic Policy Gate
# Autonomous monetary ceiling before requiring `x-agentsaga-approval-token`
POLICY_MAX_AMOUNT=500000

# Journal Backend
# Leave empty to run the high-performance in-memory WAL store.
# Set to a PostgreSQL 16 connection string for durable ACID SAGA persistence.
DATABASE_URL=
# DATABASE_URL=postgres://saga_admin:saga_secure_password@127.0.0.1:5433/agentsaga_journal

# Logging & Benchmark Silence Flag (1 disables NestJS/Express stdout/stderr noise)
BENCHMARK_QUIET=0

# Docker Compose Host Port Bindings (override if ports conflict on your machine)
POSTGRES_HOST_PORT=5433
SERVICES_HOST_PORT=3010
GATEWAY_HOST_PORT=8090

# Optional Live LLM Evaluator (eval-harness/live_llm_agent_eval.py)
GEMINI_API_KEY=
